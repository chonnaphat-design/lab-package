{
  "name": "lab-package",
  "version": "0.0.1",
  "description": "React design system built from shadcn/ui on Base UI, styled with CSS Modules over OKLCH tokens.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "cn": "^0.5.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "recharts": "^3.11.1",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  }
}
