{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // vite/client declares *.css imports (e.g. "./preview.css" in preview.ts).
    "types": ["vite/client", "node"]
  },
  "include": [".storybook/*.ts"]
}
